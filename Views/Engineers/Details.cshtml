@model SpeedSolution.Models.Engineer

@{
    ViewData["Title"] = "Engineer Details";
}

<div class="container" style="margin-top: 40px; margin-bottom: 80px;">
    <div class="card" style="padding: 40px; background: white; color: black; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
        <div style="display: flex; gap: 40px; align-items: flex-start;">
            <!-- Engineer Image -->
            <div style="flex: 0 0 200px;">
                <img src="@Model.ImageUrl" alt="@Model.FirstName @Model.LastName" style="width: 200px; height: 200px; border-radius: 50%; object-fit: cover; border: 4px solid navy;" />
                <div style="text-align: center; margin-top: 15px;">
                    <div style="color: gold; font-size: 1.5em;">★ @Model.Rating</div>
                </div>
            </div>
            
            <!-- Engineer Details -->
            <div style="flex: 1;">
                <h2 style="color: navy; font-size: 2.5em;">@Model.FirstName @Model.LastName</h2>
                <h4 style="color: #555; margin-bottom: 20px;">@Model.Specialization</h4>
                
                <div style="margin-top: 20px; font-size: 1.1em;">
                    <p><strong>Category:</strong> @Model.Category</p>
                    <p><strong>Degree:</strong> @Model.Degree</p>
                    <p><strong>Description:</strong> @Model.Description</p>
                    <p><strong>Price:</strong> $@Model.Price / hour</p>
                </div>

                <div style="margin-top: 30px;">
                    <h3>Schedule</h3>
                    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                        <tr style="background: #f9f9f9;">
                            <th style="padding: 15px; border: 1px solid #ddd; text-align: left;">Availability</th>
                            <td style="padding: 15px; border: 1px solid #ddd;">@Model.Schedule</td>
                        </tr>
                    </table>
                </div>

                <div class="mt-2" style="margin-top: 30px; display: flex; gap: 20px;">
                    @{
                        var bookingUserId = Context.Session.GetString("UserId");
                        var isUserLoggedIn = !string.IsNullOrEmpty(bookingUserId);
                    }
                    
                    @if (isUserLoggedIn)
                    {
                        <a href="/Engineers/Book/@Model.Id" class="btn" style="background: navy; color: white; padding: 15px 0; font-size: 1.2em; width: 200px; text-align: center; text-decoration: none;">Book Now</a>
                    }
                    else
                    {
                        <div class="alert alert-warning" style="background-color: #fff3cd; color: #856404; padding: 15px; border-radius: 5px; flex: 1;">
                            Please <a href="/Account/Login" style="color: navy; text-decoration: underline;">Login</a> to book this engineer.
                        </div>
                    }
                    <a href="/Engineers" class="btn" style="background-color: #ccc; color: #333; padding: 15px 0; font-size: 1.2em; width: 200px; text-align: center; text-decoration: none;">Back to List</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Rating & Comments Section -->
    <div style="margin-top: 60px; border-top: 1px solid #eee; padding-top: 40px;">
        <h3>Rate this Engineer</h3>
        <div style="background: #f9f9f9; padding: 20px; border-radius: 10px; margin-top: 20px;">
            <div class="form-group">
                <label>Your Rating</label>
                <div id="starRating" style="color: #ccc; font-size: 1.5em; cursor: pointer;">
                    <span data-value="1" onclick="setRating(1)">★</span>
                    <span data-value="2" onclick="setRating(2)">★</span>
                    <span data-value="3" onclick="setRating(3)">★</span>
                    <span data-value="4" onclick="setRating(4)">★</span>
                    <span data-value="5" onclick="setRating(5)">★</span>
                </div>
                <input type="hidden" id="selectedRating" value="0" />
            </div>
            <div class="form-group">
                <label>Your Comment</label>
                <textarea class="form-control" rows="3" placeholder="Share your experience..."></textarea>
            </div>
            <button class="btn" style="background: navy; color: white;">Submit Review</button>
        </div>
    </div>
</div>

<script>
    function setRating(value) {
        var stars = document.getElementById('starRating').children;
        document.getElementById('selectedRating').value = value;
        for (var i = 0; i < stars.length; i++) {
            if (i < value) {
                stars[i].style.color = 'gold';
            } else {
                stars[i].style.color = '#ccc';
            }
        }
    }
</script>
