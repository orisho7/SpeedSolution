@model SpeedSolution.Models.Engineer

@{
    ViewData["Title"] = "Book Engineer";
    var userFirstName = Context.Items["UserFirstName"] as string; // or however we get it
}

<div class="container" style="margin-top: 40px; margin-bottom: 80px;">
    <div class="card" style="max-width: 600px; margin: 0 auto; padding: 40px; background: white; color: black; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border-top: 5px solid navy;">
        <h2 class="text-center" style="color: navy; margin-bottom: 30px;">Book @Model.FirstName @Model.LastName</h2>

        <form asp-action="Book" method="post" id="bookingForm">
            <input type="hidden" name="EngineerId" value="@Model.Id" />
            <input type="hidden" name="EngineerName" value="@Model.FirstName @Model.LastName" />
            
            <div class="form-group">
                <label>Date</label>
                <input type="date" name="Date" required class="form-control" />
            </div>

            <div class="form-group">
                <label>Time</label>
                <input type="time" name="Time" required class="form-control" />
            </div>

            <div class="form-group">
                <label>Number of Hours</label>
                <input type="number" name="Hours" id="hours" min="1" value="1" class="form-control" onchange="updatePrice()" />
            </div>

            <div class="form-group">
                <label>Total Price</label>
                <div style="font-size: 1.5em; font-weight: bold; color: navy;">
                    $<span id="totalPrice">@Model.Price</span>
                </div>
                <!-- Hidden input to submit price, though backend should recalc -->
                <input type="hidden" name="TotalPrice" id="hiddenPrice" value="@Model.Price" />
            </div>

            <div class="form-group">
                <label>Payment Method</label>
                <select name="PaymentMethod" required class="form-control">
                    <option value="Cash">Cash</option>
                    <option value="Apple Pay">Apple Pay</option>
                </select>
            </div>

            <div class="text-center mt-2">
                <button type="submit" class="btn" style="width: 100%; background: navy; color: white; padding: 15px; font-size: 1.2em;">Confirm Booking</button>
            </div>
        </form>
    </div>
</div>

<!-- Confirmation Popup -->
@if (ViewBag.ConfirmationMessage != null)
{
    <div id="confirmationPopup" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); background: white; color: navy; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); border-radius: 8px; z-index: 1000; text-align: center; border-left: 5px solid #00e676;">
        <h4 style="margin: 0;">@ViewBag.ConfirmationMessage</h4>
    </div>

    <script>
        setTimeout(function() {
            var popup = document.getElementById('confirmationPopup');
            if (popup) {
                popup.style.transition = 'opacity 0.5s';
                popup.style.opacity = '0';
                setTimeout(function() { popup.style.display = 'none'; }, 500);
            }
        }, 3000); // 3 Seconds
    </script>
}

<script>
    var basePrice = @Model.Price;
    
    function updatePrice() {
        var hours = document.getElementById('hours').value;
        if(hours < 1) hours = 1;
        var total = basePrice * hours;
        document.getElementById('totalPrice').innerText = total;
        document.getElementById('hiddenPrice').value = total;
    }
</script>
