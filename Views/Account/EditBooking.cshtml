@model SpeedSolution.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container" style="margin-top: 40px; margin-bottom: 80px;">
    <div class="card" style="max-width: 600px; margin: 0 auto; padding: 40px; background: white; color: black; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border-top: 5px solid navy;">
        <h2 class="text-center" style="color: navy; margin-bottom: 30px;">Edit Booking</h2>
        <h4 class="text-center" style="color: dimgray; margin-bottom: 20px;">with @Model.EngineerName</h4>

        <form asp-action="EditBooking" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label>Date</label>
                <input asp-for="Date" type="date" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Time</label>
                <input asp-for="Time" type="time" class="form-control" required />
            </div>

            <div class="text-center mt-4" style="display: flex; gap: 20px; justify-content: center;">
                <button type="submit" class="btn" style="background: navy; color: white; padding: 10px 30px; border: none; border-radius: 5px;">Confirm</button>
                <a href="/Account/Profile" class="btn" style="background: #ccc; color: black; padding: 10px 30px; border-radius: 5px; text-decoration: none;">Cancel</a>
            </div>
        </form>
    </div>
</div>
