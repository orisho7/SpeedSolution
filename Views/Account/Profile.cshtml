@model SpeedSolution.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container" style="margin-top: 40px; margin-bottom: 80px;">
    <h2 class="text-center" style="color: white; margin-bottom: 30px;">User Account</h2>

    <div class="row">
        <!-- Personal Information -->
        <div class="col-md-6" style="margin-bottom: 20px;">
            <div class="card" style="padding: 30px; background: white; color: black; border-top: 5px solid navy;">
                <h3 style="color: navy; margin-bottom: 20px;">Personal Information</h3>
                
                <form asp-action="Profile" method="post">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success" style="color: green; margin-bottom: 10px;">@ViewBag.Message</div>
                    }

                    <div class="form-group">
                        <label>Profile Picture</label>
                        <!-- User Avatar: Male/Female based on registration -->
                        <div style="width: 100px; height: 100px; border-radius: 50%; margin-bottom: 10px; overflow: hidden;">
                            @if(Model.Gender == "Male") 
                            { 
                                <img src="/images/male-default.jpg" alt="Male Profile" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                            } 
                            else 
                            { 
                                <img src="/images/female-default.jpg" alt="Female Profile" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label>First Name</label>
                        <input asp-for="FirstName" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Second Name</label>
                        <input asp-for="SecondName" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Mobile Number</label>
                        <input asp-for="Mobile" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Email Address</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Date of Birth (Read-only)</label>
                        <input value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" class="form-control" disabled style="background: #e9ecef;" />
                    </div>

                    <div class="form-group">
                        <label>Gender (Read-only)</label>
                        <input asp-for="Gender" class="form-control" disabled style="background: #e9ecef;" />
                    </div>

                    <button type="submit" class="btn" style="background: navy; color: white;">Update Profile</button>
                </form>
            </div>
        </div>

        <!-- Your Bookings -->
        <div class="col-md-6">
            <h3 style="color: white; margin-bottom: 20px;">Your Bookings</h3>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 12px; border-radius: 5px; margin-bottom: 15px;">
                    @TempData["SuccessMessage"]
                </div>
            }
            
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 12px; border-radius: 5px; margin-bottom: 15px;">
                    @TempData["ErrorMessage"]
                </div>
            }
            
            @{
                var bookings = ViewBag.Bookings as List<SpeedSolution.Models.Booking>;
            }
            
            @if (bookings != null && bookings.Any())
            {
                foreach (var booking in bookings)
                {
                    <div class="card" style="padding: 20px; background: white; color: black; margin-bottom: 20px; border-left: 5px solid navy;">
                        <h4 style="color: navy;">Booking with @booking.EngineerName</h4>
                        <p><strong>Date:</strong> @booking.Date.ToString("d")</p>
                        <p><strong>Time:</strong> @booking.Time</p>
                        <p><strong>Payment Method:</strong> @booking.Payment_Method</p>
                        <p><strong>Status:</strong> <span style="color: @(booking.Payment_Status == "Accepted" ? "#28a745" : "#ffc107");">@booking.Payment_Status</span></p>
                        <p style="margin-top: 10px; font-weight: bold; color: #00e676;">We can't wait to see you!</p>
                        
                        <div style="margin-top: 15px; display: flex; gap: 10px; align-items: center;">
                            <form action="/Engineers/Book/@booking.Engineer_Id" method="get" style="display:inline; margin: 0;">
                                <button type="submit" style="background: #007bff; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-family: inherit; font-size: inherit; line-height: 1.5;">Edit Booking</button>
                            </form>
                            
                            <form asp-action="DeleteBooking" method="post" style="display:inline; margin: 0;" onsubmit="return confirm('Are you sure you want to delete this booking?');">
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button type="submit" style="background: #dc3545; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-family: inherit; font-size: inherit; line-height: 1.5;">Delete Booking</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card" style="padding: 20px; background: white; color: black;">
                    <p>No bookings yet. <a href="/Engineers" style="color: navy; text-decoration: underline;">Browse engineers</a> to make your first booking!</p>
                </div>
            }
        </div>
    </div>
</div>
