@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section (Ventrex Style) -->
<div class="hero-section" style="background: url('https://via.placeholder.com/1920x600/010130/FFFFFF?text=Network+Excellence') no-repeat center center; background-size: cover; height: 600px; display: flex; align-items: center; justify-content: center; text-align: center; color: white; margin-top: -20px; margin-left: -20px; margin-right: -20px; position: relative;">
    <div style="background: rgba(0,0,0,0.5); padding: 40px; border-radius: 10px;">
        <h1 class="display-4" style="font-family: 'Playfair Display', serif; font-size: 4em; font-style: italic;">Speed Solution</h1>
        <p style="font-size: 1.5em; margin-top: 20px;">Connecting you with the world's best network engineers.</p>
        <a href="/Engineers" class="btn" style="margin-top: 30px; padding: 15px 40px; font-size: 1.2em; background: white; color: navy;">Find an Engineer</a>
    </div>
</div>

<div class="container" style="margin-top: 60px;">
    <!-- How It Works -->
    <div id="bookingWorkflow" style="margin-bottom: 80px;">
        <h2 class="text-center mb-2" style="color: white; font-size: 2.5em;">How It Works</h2>
        <div style="display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
            <div class="card" style="flex: 1; min-width: 250px; padding: 30px; text-align: center; border-top: 5px solid navy;">
                <div style="font-size: 3em; color: navy; margin-bottom: 20px;">1</div>
                <h3 style="color: navy;">Register & Login</h3>
                <p>Create your profile to get started with our services.</p>
            </div>
            <div class="card" style="flex: 1; min-width: 250px; padding: 30px; text-align: center; border-top: 5px solid navy;">
                <div style="font-size: 3em; color: navy; margin-bottom: 20px;">2</div>
                <h3 style="color: navy;">Browse Engineers</h3>
                <p>Explore our extensive list of certified professionals.</p>
            </div>
            <div class="card" style="flex: 1; min-width: 250px; padding: 30px; text-align: center; border-top: 5px solid navy;">
                <div style="font-size: 3em; color: navy; margin-bottom: 20px;">3</div>
                <h3 style="color: navy;">Book Consultation</h3>
                <p>Schedule a time and solve your network issues.</p>
            </div>
            <!-- 4th Box -->
            <div class="card" style="flex: 1; min-width: 250px; padding: 30px; text-align: center; border-top: 5px solid navy;">
                <div style="font-size: 3em; color: navy; margin-bottom: 20px;">4</div>
                <h3 style="color: navy;">Rate Engineer</h3>
                <p>Share your experience and help others choose.</p>
            </div>
        </div>
    </div>

    <!-- Employment Section -->
    <div class="employment-section" style="background: white; color: navy; padding: 60px; border-radius: 10px; margin-bottom: 80px; display: flex; align-items: center; gap: 40px;">
        <div style="flex: 1;">
            <h2 style="font-size: 2.5em; margin-bottom: 20px;">Join Our Team</h2>
            <p style="font-size: 1.2em; margin-bottom: 30px;">Are you a skilled network engineer? Join Speed Solution and connect with clients worldwide.</p>
            <a href="/ContactUs" class="btn" style="background: navy; color: white;">Apply Now</a>
        </div>
        <div style="flex: 1;">
            <img src="/images/Join Our Team.jpg" alt="Employment" style="width: 100%; border-radius: 10px;" />
        </div>
    </div>

    <!-- Rating Section -->
    <div class="rating-section" style="text-align: center; margin-bottom: 80px;">
        <h2 style="color: white; font-size: 2.5em; margin-bottom: 40px;">What Our Clients Say</h2>
        <div style="display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;">
            <div class="card" style="flex: 1; max-width: 350px; text-align: left;">
                <div style="color: gold; font-size: 1.5em; margin-bottom: 10px;">★★★★★</div>
                <p>"Excellent service! The engineer solved my routing issue in minutes."</p>
                <div style="margin-top: 20px; font-weight: bold; color: navy;">- Ahmed Al-Saud</div>
            </div>
            <div class="card" style="flex: 1; max-width: 350px; text-align: left;">
                <div style="color: gold; font-size: 1.5em; margin-bottom: 10px;">★★★★★</div>
                <p>"Very professional and knowledgeable. Highly recommended."</p>
                <div style="margin-top: 20px; font-weight: bold; color: navy;">- Sarah Johnson</div>
            </div>
            <div class="card" style="flex: 1; max-width: 350px; text-align: left;">
                <div style="color: gold; font-size: 1.5em; margin-bottom: 10px;">★★★★☆</div>
                <p>"Great platform to find network experts quickly."</p>
                <div style="margin-top: 20px; font-weight: bold; color: navy;">- Mohammed Ali</div>
            </div>
        </div>
    </div>
</div>
