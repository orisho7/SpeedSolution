@{
    ViewData["Title"] = "Contact Us";
}

<div class="container">
    <h2 class="text-center mb-2" style="color: white; font-size: 2.5em;">Contact Us</h2>
    
    <div class="row" style="display: flex; gap: 40px; flex-wrap: wrap;">
        <!-- Contact Form -->
        <div class="col-md-8" style="flex: 2; min-width: 300px;">
            <div class="card" style="color: navy;">
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 10px; border-radius: 5px; margin-bottom: 20px;">
                        @TempData["Message"]
                    </div>
                }

                <form asp-action="Submit" method="post">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="mobile">Mobile Number</label>
                        <div style="display: flex; align-items: center;">
                            <span style="background: #eee; padding: 10px; border: 1px solid #ccc; border-right: none; border-radius: 4px 0 0 4px;">966</span>
                            <input type="text" name="mobile" class="form-control" style="border-radius: 0 4px 4px 0;" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="note">Complaint / Message</label>
                        <textarea name="note" class="form-control" rows="5" maxlength="250" required placeholder="Describe your issue (Max 250 chars)..." style="border-bottom: 3px solid #ccc;"></textarea>
                        <small class="text-muted">Max 250 characters</small>
                    </div>
                    
                    <div class="form-group text-center">
                        <button type="submit" class="btn" style="width: 100%; background: navy; color: white; transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">Send Message</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Side Info -->
        <div class="col-md-4" style="flex: 1; min-width: 250px; color: white;">
            <div style="background: rgba(255,255,255,0.1); padding: 30px; border-radius: 10px;">
                <h3 style="border-bottom: 2px solid white; padding-bottom: 10px; margin-bottom: 20px;">Information</h3>
                <div style="margin-bottom: 20px;">
                    <strong>Location:</strong><br/>
                    Saudi Arabia
                </div>
                <div style="margin-bottom: 20px;">
                    <strong>Careers:</strong><br/>
                    <a href="#" style="color: white; text-decoration: underline;">Join us</a>
                </div>
                <div style="margin-bottom: 20px;">
                    <strong>Social:</strong><br/>
                    <a href="#" style="color: white; text-decoration: underline;">Follow us on Twitter</a>
                </div>
            </div>
        </div>
    </div>
</div>
